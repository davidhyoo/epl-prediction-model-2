# ---------------------------------------------------------------------------
# Environment variables for the 2026 World Cup Prediction Dashboard
# ---------------------------------------------------------------------------
# The app runs FULLY OFFLINE by default using the deterministic data generated
# by the Python pipeline (public/data/*.json). None of the variables below are
# required to run, build, or test the app. They only enable OPTIONAL live-data
# refresh from free/open sources. Copy this file to `.env.local` and fill in
# values only if you want to experiment with live data ingestion.
#
# NEVER commit real secrets. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Optional: free football data API (https://www.football-data.org, free tier).
# Leave blank to use the bundled deterministic sample dataset.
FOOTBALL_DATA_API_KEY=

# Optional: base URL override for the (open) Elo ratings source used by the
# ingest step. Leave blank to use the bundled cached ratings.
ELO_RATINGS_SOURCE_URL=

# Optional: set to "1" to allow the pipeline to attempt live network fetches.
# Default (unset/0) keeps the pipeline fully offline & reproducible.
ENABLE_LIVE_DATA=0

# Optional: enable the in-app "Refresh data" button (POST /api/refresh), which
# runs `python ml/refresh.py` on the server to pull the latest results + real
# player stats and rebuild the JSON. Enabled automatically in development; set
# to "1" to allow it in a production/self-hosted deployment you trust.
ALLOW_DATA_REFRESH=

# Optional: Python executable used by /api/refresh if `python` isn't on PATH
# (e.g. "python3" or an absolute path to a virtualenv interpreter).
PYTHON_BIN=

