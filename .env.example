# ---------------------------------------------------------------------------
# Environment variables — Soccer Agent (EPL + La Liga prediction dashboard)
# ---------------------------------------------------------------------------
# The app runs FULLY OFFLINE by default. Everything the frontend needs is the
# deterministic JSON produced by the Python pipeline and committed under
# `public/data/**`. None of the variables below are required to run, build, or
# test the app. They only tune the OPTIONAL in-app "Refresh data" button.
#
# The data pipeline itself reads NO environment variables and needs NO API keys:
# it fetches only free, openly-licensed public files (openfootball = CC0,
# football-data.co.uk = free, Wikipedia/Wikimedia Commons). NEVER commit real
# secrets — `.env.local` is git-ignored.
#
# To use: copy this file to `.env.local` and set values as needed.
# ---------------------------------------------------------------------------

# Enable the in-app "Refresh data" button (POST /api/refresh), which shells out
# to `python ml/club_refresh.py` on the server to pull the latest results,
# scorers and market odds and rebuild the JSON. Enabled AUTOMATICALLY in
# development (`next dev`); it is DISABLED by default in a production build.
# Set to "1" to allow it in a production/self-hosted deployment you trust.
ALLOW_DATA_REFRESH=

# Python executable used by /api/refresh when `python` isn't on PATH
# (e.g. "python3", "py", or an absolute path to a virtualenv interpreter).
# Leave blank to use whatever `python` resolves to.
PYTHON_BIN=
