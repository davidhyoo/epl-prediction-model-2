{
  "name": "data-driven-soccer",
  "version": "1.0.0",
  "private": true,
  "description": "Data Driven Soccer — EPL + La Liga prediction & analytics dashboard. Next.js + TypeScript frontend with a reproducible Python (scikit-learn / XGBoost) ML pipeline.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:refresh": "python ml/club_pipeline.py",
    "data:retrain": "python ml/club_pipeline.py --retrain",
    "data:fetch": "python ml/club_refresh.py",
    "data:fetch:offline": "python ml/club_refresh.py --offline",
    "data:fetch:squads": "python ml/club_refresh.py --squads",
    "data:fetch:crests": "python ml/club_refresh.py --crests",
    "ml:squads": "python ml/club_fetch_squads.py",
    "ml:train": "python ml/club_train.py",
    "ml:predict": "python ml/club_predict.py",
    "ml:simulate": "python ml/club_simulate.py",
    "ml:evaluate": "python ml/club_evaluate.py",
    "test:py": "python -m pytest ml/tests -q"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "flag-icons": "^7.5.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
